# Un-ignore HTML/JS overridden by global gitignore
!*.html
!*.js

# Excel workbooks — never commit, data stays local
*.xlsx
*.xls
*.xlsm

# Python
__pycache__/
*.pyc
*.pyo

# macOS
.DS_Store
.AppleDouble

# Internal files
internal_README.md
claude.md
Point_Spreadsheet.xlsx

# Local-only misuse tooling and its output. flag_attendance_timing.py still
# says it "lives in local-notes/, which is gitignored" — that stopped being
# true when it moved to watchdog/, and nothing here was excluded. It renders
# charts of individual residents' check-in times into attendance_reports/,
# and this repository is public.
watchdog/

# Credentials — never commit
.env
